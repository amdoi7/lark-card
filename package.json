{
  "name": "lark-card",
  "version": "0.1.0",
  "private": true,
  "description": "Local Lark card editor and PNG preview for humans and agents",
  "bin": {
    "lark-card": "./src/cli/index.ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "setup-assets": "bun src/assets/setup-compiler.ts && bun src/assets/setup-editor.ts",
    "serve": "bun src/cli/serve.ts",
    "format": "oxfmt --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json .oxfmtrc.json",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json .oxfmtrc.json",
    "lint": "oxlint --deny-warnings src tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test": "bun test tests"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "pi": {
    "skills": [
      "./skills/lark-card"
    ]
  }
}
