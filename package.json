{
  "name": "lark-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "description": "Local Lark card editor and PNG preview for humans and agents",
  "exports": {
    ".": "./src/core.ts"
  },
  "bin": {
    "lark-card": "./src/cli.ts"
  },
  "scripts": {
    "setup-assets": "bun runtime/prepare.ts && bun runtime/prepare-editor.ts",
    "serve": "bun runtime/serve.ts",
    "check": "tsc --noEmit",
    "test": "bun test tests"
  },
  "pi": {
    "skills": [
      "./skills/lark-card"
    ]
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
